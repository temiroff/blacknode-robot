  "metadata": {
    "template": true,
    "description": "Read-only ROS robot discovery. Run this while the robot's existing ROS 2 bringup is active. Blacknode inventories topics, nodes, and services, then identifies generic camera, depth camera, LiDAR, IMU, battery, GPS, joint-state, and mobile-base candidates from standard interface types. It does not create a robot-specific profile, publish commands, start drivers, or arm motion. Review Unclassified ROS topics next when a device uses custom messages.",
    "color": "#14b8a6",
    "required_packages": [
      "blacknode-robot",
      "blacknode-ros2"
    ],
    "required_components": [
      "blacknode-robot/capabilities",
      "blacknode-ros2/core",
      "blacknode-ros2/diagnostics",
      "blacknode-ros2/services",
      "blacknode-ros2/topics"
    ]
  },
