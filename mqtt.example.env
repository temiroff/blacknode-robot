# Copy this file beside device.json as mqtt.env, then set permissions to 0600.
# The systemd service reads it automatically when present.
BLACKNODE_MQTT_URL=mqtts://broker.example.com:8883
BLACKNODE_MQTT_TOPIC_PREFIX=blacknode
BLACKNODE_MQTT_USERNAME=robot-device
BLACKNODE_MQTT_PASSWORD_FILE=/absolute/path/to/mqtt.password
BLACKNODE_MQTT_QOS=0
BLACKNODE_MQTT_KEEPALIVE=30
BLACKNODE_TELEMETRY_INTERVAL=0.1
